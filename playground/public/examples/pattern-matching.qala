enum Shape {
    Circle(f64),
    Rect(f64, f64),
    Triangle(f64, f64, f64),
}

fn area(s: Shape) -> f64 is pure {
    match s {
        Circle(r) => 3.14159 * r * r,
        Rect(w, h) => w * h,
        Triangle(a, b, c) => {
            let half = (a + b + c) / 2.0
            sqrt(half * (half - a) * (half - b) * (half - c))
        }
    }
}

fn classify(value: i64) -> str is pure {
    if value > 0 { return "positive" }
    if value < 0 { return "negative" }
    return "zero"
}

fn main() is io {
    let shapes = [
        Circle(5.0),
        Rect(3.0, 4.0),
        Triangle(3.0, 4.0, 5.0),
    ]

    for s in shapes {
        println("area: {area(s)}")
    }

    println(classify(42))
    println(classify(-7))
    println(classify(0))
}
